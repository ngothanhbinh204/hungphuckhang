section.contact
	.container 
		.contact-wrapper
			.contact-info-col
				.contact-header
					p.greeting Xin chào chúng tôi là
					h1.brand-name KC Hà Tĩnh
				
				.contact-details
					.detail-item
						.icon
							i.fa-light.fa-location-dot
						.text
							p Km 09 đường tránh Thành phố, Phường Hà Huy Tập, tỉnh Hà Tĩnh, Việt Nam
					.detail-item
						.icon
							i.fa-light.fa-phone
						.text
							a(href="tel:19008026") 19008026
					.detail-item
						.icon
							i.fa-light.fa-envelope
						.text
							a(href="mailto:contact@kchatinh.vn") contact@kchatinh.vn

				.contact-map
					iframe(src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d15124.969850624022!2d105.8893148443907!3d18.336043444855077!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31384f6869766d95%3A0xc6a8a38575a7c03!2zSMOgIEh1eSBU4bqtcCwgSGF0aW5oLCBWaWV0bmFt!5e0!3m2!1sen!2s!4v1709484000000!5m2!1sen!2s" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade")

			.contact-form-col
				.form-box
					.form-header
						p Mọi sự hợp tác tốt đẹp đều bắt đầu từ một cuộc trò chuyện. Hãy liên hệ với chúng tôi,
						p mọi mong muốn của bạn #[span sẽ được lắng nghe.]
					
					.form-wrapper
						.row_form
							.form-group
								span.wpcf7-form-control-wrap
									input(type="text" placeholder="Họ và tên")
							.form-group
								span.wpcf7-form-control-wrap
									input(type="email" placeholder="Email")
						.row_form
							.form-group
								span.wpcf7-form-control-wrap
									input(type="tel" placeholder="Điện thoại")
							.form-group
								span.wpcf7-form-control-wrap
									input(type="text" placeholder="Tiêu đề")
						.row_form
							.form-group.full-width
								span.wpcf7-form-control-wrap
									textarea(placeholder="Nội dung" rows="5")
						
						.form-submit
							button(type="submit") Gửi #[i.fa-light.fa-arrow-up-right]
