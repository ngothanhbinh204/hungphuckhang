section.chothue-4
	.container
		.section-header(data-aos="fade-up")
			h2.section-title BẢNG GIÁ CHO THUÊ
		
		.pricing-grid
			- 
				var plans = [
					{
						title: 'PREMIUM (MOST POPULAR)',
						price: '5,000,000đ',
						unit: ' / Tháng',
						features: [
							{ text: '<b>Tốc độ in:</b> 30 - 40 bản/phút', active: true },
							{ text: '<b>Chức năng:</b> In - Photo - Scan màu', active: true },
							{ text: '<b>Số lượng bản in:</b> Tối đa 3.000 bản', active: true },
							{ text: '<b>Bố cục khổ giấy:</b> A5 - A4 - A3', active: true },
							{ text: '<b>Hỗ trợ kỹ thuật:</b> Trong vòng 2h', active: true },
							{ text: 'Phụ phí vượt hạn mức: 120đ/bản', active: false }
						],
						note: '(Hợp đồng từ 12 tháng)'
					},
					{
						title: 'PREMIUM (MOST POPULAR)',
						price: '8,000,000đ',
						unit: ' / Tháng',
						features: [
							{ text: '<b>Tốc độ in:</b> 50 - 60 bản/phút', active: true },
							{ text: '<b>Chức năng:</b> In - Photo - Scan màu', active: true },
							{ text: '<b>Số lượng bản in:</b> Tối đa 10.000 bản', active: true },
							{ text: '<b>Số lượng bản in:</b> Tối đa 10.000 bản', active: true },
							{ text: '<b>Số lượng bản in:</b> Tối đa 10.000 bản', active: true },
							{ text: '<b>Số lượng bản in:</b> Tối đa 10.000 bản', active: true },
							{ text: '<b>Bố cục khổ giấy:</b> A5 - A4 - A3', active: true },
							{ text: '<b>Hỗ trợ kỹ thuật:</b> Trong vòng 1h', active: true },
							{ text: 'Miễn phí 500 bản in màu đầu tiên', active: true }
						],
						note: '(Hợp đồng từ 12 tháng)'
					},
					{
						title: 'PREMIUM (MOST POPULAR)',
						price: '12,000,000đ',
						unit: ' / Tháng',
						features: [
							{ text: '<b>Tốc độ in:</b> 75 - 90 bản/phút', active: true },
							{ text: '<b>Chức năng:</b> In - Photo - Scan màu', active: true },
							{ text: '<b>Số lượng bản in:</b> Không giới hạn', active: true },
							{ text: '<b>Bố cục khổ giấy:</b> A5 - A4 - A3', active: true },
							{ text: '<b>Hỗ trợ kỹ thuật:</b> Ưu tiên 24/7', active: true },
							{ text: 'Bảo trì định kỳ hàng tháng', active: true }
						],
						note: '(Hợp đồng từ 6 tháng)'
					}
				]
			each plan, index in plans
				.pricing-col(data-aos="fade-up" data-aos-delay=(index * 100))
					.pricing-card
						.card-header
							.wrapper-package
								span= plan.title
							.price-block
								h3.price
									span.value= plan.price
									span.unit= plan.unit
						.card-body
							ul.feature-list
								each feat in plan.features
									li(class=(feat.active ? '' : 'inactive'))
										.icon
											if feat.active
												i.fa-solid.fa-circle-check
											else
												i.fa-solid.fa-circle-xmark
										span.text !{feat.text}
							
							.card-footer
								p.note= plan.note
