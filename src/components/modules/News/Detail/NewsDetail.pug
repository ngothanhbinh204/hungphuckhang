	.container-ofSlide
		.news-detail-related
			.section-header
				h2 Tin tức liên quan
			.news-related-swiper.swiper-container
				.swiper-wrapper
					-for(var i = 0; i < 6; i++)
						.swiper-slide
							+NewsItem()
			.swiper-nav-wrapper
				.swiper-button-prev.related-prev
					i.fa-light.fa-arrow-left
				.swiper-button-next.related-next
					i.fa-light.fa-arrow-right